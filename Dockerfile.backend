# syntax=docker/dockerfile:1

# ── TLS certs + timezone data (copied to scratch) ────────────────────────────
FROM alpine:3.24 AS certs
RUN apk add --no-cache ca-certificates tzdata

# ── Builder ───────────────────────────────────────────────────────────────────
FROM golang:1.27-alpine AS builder

ARG VERSION=dev
WORKDIR /app

COPY backend/go.mod backend/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY backend/ .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build \
      -trimpath \
      -ldflags="-s -w -X main.version=${VERSION}" \
      -o /tanteemma \
      ./main.go

# ── Runtime (scratch — smallest possible attack surface) ─────────────────────
FROM scratch

COPY --from=certs /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=certs /usr/share/zoneinfo /usr/share/zoneinfo
COPY --from=builder /tanteemma /tanteemma

# Runs as root by default so it can write the SQLite data volume. Under rootless
# podman, container-root maps to the host user (who owns ./data); under Docker,
# root can write the mounted volume too. A hardcoded non-root UID instead maps to
# an unprivileged subuid that does NOT own a bind-mounted ./data, which makes
# SQLite open read-only and the backend exit ("attempt to write a readonly
# database"). To run non-root, set `user:` in compose to a UID that owns the data
# volume (e.g. the host UID for a bind mount, or chown a named volume first).

EXPOSE 8080
ENTRYPOINT ["/tanteemma"]
