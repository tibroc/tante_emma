# Copy this file to .env and fill in the values.
# Generate random keys with: openssl rand -hex 32

# ─── Required ───────────────────────────────────────────────────────────────

DB_PATH=/data/tanteemma.db

# 32-byte hex keys for session cookie signing/encryption
SESSION_HASH_KEY=<openssl rand -hex 32>
SESSION_BLOCK_KEY=<openssl rand -hex 32>

# OIDC provider (Authentik, Keycloak, Dex, Google, GitHub, …)
OIDC_ISSUER_URL=https://auth.yourdomain.com/application/o/tanteemma/
OIDC_CLIENT_ID=tanteemma
OIDC_CLIENT_SECRET=<your-oidc-client-secret>
OIDC_REDIRECT_URL=https://shopping.yourdomain.com/auth/callback

# ─── Optional ───────────────────────────────────────────────────────────────

PORT=8080
LOG_LEVEL=info                    # debug | info | warn | error
FRONTEND_URL=https://shopping.yourdomain.com
MAX_UPLOAD_SIZE=5242880           # bytes (default: 5MB)

# Secure flag on auth cookies. Auto-detected from OIDC_REDIRECT_URL (https → true);
# set explicitly to override. Must be false for plain-HTTP localhost development.
SECURE_COOKIES=true

# Production URLs (used in docker-compose.prod.yml)
BACKEND_URL=https://api.yourdomain.com
BACKEND_WS_URL=wss://api.yourdomain.com

# Litestream backup (optional — leave blank to skip)
LITESTREAM_REPLICA_URL=s3://your-bucket/tanteemma
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
