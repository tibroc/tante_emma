# syntax=docker/dockerfile:1

# ── Builder ───────────────────────────────────────────────────────────────────
FROM node:26-alpine AS builder

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci

COPY frontend/ .
# Vite SPA build -> static assets in dist/.
RUN npm run build

# Keep only runtime deps (the static server: sirv-cli).
RUN --mount=type=cache,target=/root/.npm \
    npm ci --omit=dev

# ── Runtime ───────────────────────────────────────────────────────────────────
FROM node:26-alpine

WORKDIR /app

# Serve the prebuilt SPA with sirv (--single = history fallback for client routes).
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/package.json ./

ENV NODE_ENV=production

# Run as the built-in non-root node user.
USER node

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD node -e "fetch('http://localhost:3000/').then(r=>r.ok||process.exit(1)).catch(()=>process.exit(1))"

CMD ["npm", "run", "start"]
