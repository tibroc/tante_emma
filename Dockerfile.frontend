# Build stage
FROM node:24-alpine AS builder
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ .
RUN npm run build
# Strip devDependencies so node_modules can be copied straight into runtime.
RUN npm prune --omit=dev

# Runtime stage
FROM node:24-alpine
WORKDIR /app
# adapter-node does NOT bundle dependencies — external imports (e.g. 'idb',
# 'ulid') resolve from node_modules at runtime. Copy the pruned tree from the
# builder so it always matches the freshly compiled build (no separate cached
# npm-ci layer that podman can skip).
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/build ./build
COPY --from=builder /app/package.json ./
ENV NODE_ENV=production
EXPOSE 3000
CMD ["node", "build"]
